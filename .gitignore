site_coordinates.csv
sites_*.csv
sites_*.geojson
sites_*.gpkg

# Build / log artefacts
*.log
.cache/
.tmp/

# ----------------------------------------------------------------------------
# Paper-only artefacts. Only figs/ and src/ are tracked; the LaTeX manuscript,
# bibliography, class files, build artefacts, paper-figure scripts, cached
# JSON, and paper-only directories live alongside the repo locally but are
# not part of the public release.
# ----------------------------------------------------------------------------

# LaTeX source and build products
*.tex
*.bib
*.bst
*.cls
*.fls
*.fdb_latexmk
*.aux
*.toc
*.out
*.synctex.gz
*.bbl
*.blg

# Top-level Python (paper-figure generation; src/ scripts are tracked)
/*.py

# Top-level JSON (paper-figure caches)
/*.json

# Paper-only directories
/figures/
/review/
/references/
